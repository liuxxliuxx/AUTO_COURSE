# Electron 二进制走 npmmirror 镜像。
# 默认的 GitHub Releases 在国内网络下不可达，会导致 `npm install` 之后
# node_modules/electron/dist 为空、应用无法启动。
#
# npm 会对这两个键报 "Unknown project config" 警告 —— 这是预期的：
# @electron/get 通过 npm_config_* 环境变量读取它们，警告可以忽略。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
