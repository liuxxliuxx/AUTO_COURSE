{
  "name": "auto-course",
  "version": "3.0.0",
  "description": "智慧树自动刷课桌面应用 (Electron + Vue 3 + Playwright)",
  "main": "./out/main/index.js",
  "author": "InvalidNamee",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run licenses && npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "npm run build && electron-builder --win --publish never --config electron-builder.yml",
    "build:mac": "npm run build && electron-builder --mac --publish never --config electron-builder.yml",
    "postinstall": "node scripts/check-native.mjs",
    "check:native": "node scripts/check-native.mjs",
    "glyph:prepare": "node scripts/prepare-glyph-runtime.mjs",
    "glyph:check": "node scripts/check-glyph-runtime.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "licenses": "node scripts/collect-licenses.mjs"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "jpeg-js": "0.4.4",
    "onnxruntime-node": "1.23.2",
    "playwright-core": "^1.63.0",
    "pngjs": "7.0.0",
    "sherpa-onnx": "1.13.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "js-yaml": "^4.3.2",
    "pinia": "^4.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "productName": "AUTO_COURSE",
  "homepage": "https://github.com/liuxxliuxx/AUTO_COURSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuxxliuxx/AUTO_COURSE.git"
  },
  "bugs": {
    "url": "https://github.com/liuxxliuxx/AUTO_COURSE/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "liuxxliuxx"
    },
    {
      "name": "InvalidNamee"
    }
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "documentation": "https://github.com/liuxxliuxx/AUTO_COURSE/tree/rewrite/electron/docs"
}
